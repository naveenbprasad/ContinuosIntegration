pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'Building the web application...'
                bat 'mvn clean package'
            }
        }

        stage('Deploy') {
                   steps {
                       script {
                           echo 'Deploying the WAR file to Tomcat...'
                           def deployCommand = """
                              curl -u admin:admin -X POST "http://localhost:8081/manager/text/deploy?path=/my-app&update=true" -F "war=@target/WebApplication-1.0-SNAPSHOT.war"
                           """
                           bat deployCommand
                       }
                   }
               }
          stage('Test') {
                    steps {
                        echo 'Running tests...'
                    }
                }
    }
    post {
        success {
            echo 'Deployment successful! Access the application at http://localhost:8081/my-java-webapp/'
        }
        failure {
            echo 'Deployment failed. Check the logs for details.'
        }
    }
}
